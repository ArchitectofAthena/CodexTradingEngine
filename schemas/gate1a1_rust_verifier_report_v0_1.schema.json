{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArchitectofAthena/CodexTradingEngine/schemas/gate1a1_rust_verifier_report_v0_1.schema.json",
  "title": "Gate 1A.1 Rust Verifier Replay Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "report_id": {"type": "string", "pattern": "^rust-verifier-report:[0-9a-f]{24}$"},
    "schema_version": {"const": "gate1a1-rust-verifier-report-v0.1"},
    "manifest_id": {"type": "string", "minLength": 1},
    "binary_path": {"type": "string"},
    "binary_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "output_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "replay_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "input_schema_version": {"type": "string"},
    "output_schema_version": {"type": "string"},
    "deterministic_replay": {"type": "boolean"},
    "outcome": {"enum": ["HOLD_UNVERIFIED_BINARY", "VERIFIED_RESEARCH_BINARY"]},
    "hold_reasons": {"type": "array", "items": {"type": "string"}},
    "authority": {"const": false},
    "artifact_is_command": {"const": false},
    "may_execute": {"const": false},
    "may_sign": {"const": false},
    "may_submit_transaction": {"const": false},
    "may_access_wallet": {"const": false},
    "may_move_capital": {"const": false},
    "gate1b_activated": {"const": false},
    "human_promotion_required": {"const": true}
  },
  "required": [
    "report_id",
    "schema_version",
    "manifest_id",
    "binary_path",
    "binary_sha256",
    "output_sha256",
    "replay_sha256",
    "input_schema_version",
    "output_schema_version",
    "deterministic_replay",
    "outcome",
    "hold_reasons",
    "authority",
    "artifact_is_command",
    "may_execute",
    "may_sign",
    "may_submit_transaction",
    "may_access_wallet",
    "may_move_capital",
    "gate1b_activated",
    "human_promotion_required"
  ]
}
