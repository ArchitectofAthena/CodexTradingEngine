{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArchitectofAthena/CodexTradingEngine/schemas/gate1a1_second_source_candidate_v0_1.schema.json",
  "title": "Codex Gate 1A.1 Second-Source Candidate v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "contract_version",
    "generated_at",
    "receipt_sha256",
    "primary_source",
    "candidate",
    "evidence",
    "decision",
    "boundary"
  ],
  "properties": {
    "artifact_type": {"const": "Gate1A1SecondSourceCandidate"},
    "contract_version": {"const": "codex-gate1a1-second-source-v0.1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "primary_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "operator", "provenance_group"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "operator": {"type": "string", "minLength": 1},
        "provenance_group": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "network_name",
        "chain_id",
        "endpoint_url",
        "host",
        "endpoint_class",
        "operator",
        "transport_method",
        "rpc_method",
        "request_body_sha256",
        "response_contract",
        "provenance_group",
        "relationship_to_primary",
        "terms_review",
        "live_capture_status",
        "review_expires_at"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"},
        "network_name": {"const": "Ethereum Sepolia"},
        "chain_id": {"const": "11155111"},
        "endpoint_url": {"const": "https://ethereum-sepolia-rpc.publicnode.com"},
        "host": {"const": "ethereum-sepolia-rpc.publicnode.com"},
        "endpoint_class": {"const": "json_rpc"},
        "operator": {"const": "PublicNode"},
        "transport_method": {"const": "POST"},
        "rpc_method": {"const": "eth_blockNumber"},
        "request_body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "response_contract": {"const": "jsonrpc=2.0; id=1; result=0x-prefixed quantity; no error object"},
        "provenance_group": {"type": "string", "minLength": 1},
        "relationship_to_primary": {
          "enum": ["DISTINCT_OPERATOR_CANDIDATE", "SHARED_OR_UNKNOWN"]
        },
        "terms_review": {"enum": ["PENDING", "REVIEWED", "REJECTED"]},
        "live_capture_status": {"enum": ["NOT_RUN", "PASS", "FAIL"]},
        "review_expires_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "references",
        "source_review_receipt_sha256",
        "capture_receipt_sha256",
        "notes"
      ],
      "properties": {
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_review_receipt_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "capture_receipt_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reasons", "eligible", "capture_authorized", "human_review_required"],
      "properties": {
        "code": {
          "enum": [
            "HOLD_TERMS_REVIEW",
            "HOLD_CAPTURE_EVIDENCE",
            "HOLD_CONCENTRATION",
            "READY_FOR_ELIGIBILITY_REVIEW"
          ]
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "eligible": {"const": false},
        "capture_authorized": {"const": false},
        "human_review_required": {"const": true}
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_is_command",
        "authority",
        "network_capture_performed",
        "may_generate_live_proposal",
        "may_execute",
        "may_sign",
        "may_submit_transaction",
        "may_access_wallet",
        "may_move_capital",
        "automatic_promotion",
        "human_promotion_required"
      ],
      "properties": {
        "artifact_is_command": {"const": false},
        "authority": {"const": false},
        "network_capture_performed": {"const": false},
        "may_generate_live_proposal": {"const": false},
        "may_execute": {"const": false},
        "may_sign": {"const": false},
        "may_submit_transaction": {"const": false},
        "may_access_wallet": {"const": false},
        "may_move_capital": {"const": false},
        "automatic_promotion": {"const": false},
        "human_promotion_required": {"const": true}
      }
    }
  }
}
