{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArchitectofAthena/CodexTradingEngine/schemas/gate1a1_rust_verifier_manifest_v0_2.schema.json",
  "title": "Gate 1A.1 Rust Verifier Provenance Manifest v0.2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifest_id": {"type": "string", "pattern": "^rust-verifier-manifest:[0-9a-f]{24}$"},
    "schema_version": {"const": "gate1a1-rust-verifier-manifest-v0.2"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cargo_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cargo_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "response_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "build_command": {"type": "string", "minLength": 1},
    "rustc_version": {"type": "string", "minLength": 1},
    "cargo_version": {"type": "string", "minLength": 1},
    "package_origin": {"type": "string", "minLength": 1},
    "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_triple": {"type": "string", "minLength": 1},
    "tree_posture": {"enum": ["CLEAN", "REVIEWED_DIGEST"]},
    "input_schema_version": {"type": "string", "minLength": 1},
    "output_schema_version": {"type": "string", "minLength": 1},
    "authority": {"const": false},
    "artifact_is_command": {"const": false},
    "may_execute": {"const": false},
    "may_sign": {"const": false},
    "may_submit_transaction": {"const": false},
    "may_access_wallet": {"const": false},
    "may_move_capital": {"const": false},
    "gate1b_activated": {"const": false},
    "human_promotion_required": {"const": true}
  },
  "required": [
    "manifest_id",
    "schema_version",
    "source_commit",
    "source_tree_sha256",
    "cargo_manifest_sha256",
    "cargo_lock_sha256",
    "response_schema_sha256",
    "build_command",
    "rustc_version",
    "cargo_version",
    "package_origin",
    "binary_sha256",
    "target_triple",
    "tree_posture",
    "input_schema_version",
    "output_schema_version",
    "authority",
    "artifact_is_command",
    "may_execute",
    "may_sign",
    "may_submit_transaction",
    "may_access_wallet",
    "may_move_capital",
    "gate1b_activated",
    "human_promotion_required"
  ]
}
