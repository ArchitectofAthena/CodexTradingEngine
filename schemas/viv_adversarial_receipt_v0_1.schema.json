{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArchitectofAthena/CodexTradingEngine/schemas/viv_adversarial_receipt_v0_1.schema.json",
  "title": "ViV Adversarial Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "role",
    "validator_id",
    "seed",
    "created_at",
    "candidate_hash",
    "case_count",
    "blocked_count",
    "escaped_count",
    "overall_outcome",
    "candidate_unchanged",
    "cases",
    "repair_required",
    "self_certifying",
    "authority",
    "artifact_is_command",
    "network_access",
    "dynamic_code_loading",
    "human_promotion_required",
    "may_execute",
    "may_deploy",
    "may_merge",
    "may_sign",
    "may_broadcast",
    "may_access_wallet",
    "may_move_capital",
    "may_mutate_canonical_memory",
    "boundary_law",
    "receipt_id"
  ],
  "properties": {
    "schema": {"const": "eve_q.viv_adversarial_receipt.v0.1"},
    "version": {"const": "0.1.0"},
    "role": {"const": "sandboxed_adversarial_tester"},
    "validator_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "created_at": {"type": "string", "minLength": 1},
    "candidate_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "case_count": {"type": "integer", "minimum": 1},
    "blocked_count": {"type": "integer", "minimum": 0},
    "escaped_count": {"type": "integer", "minimum": 0},
    "overall_outcome": {"enum": ["pass", "fail"]},
    "candidate_unchanged": {"const": true},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "name",
          "target_invariant",
          "severity",
          "derived_seed",
          "status",
          "mutated_artifact_hash",
          "validator_exception_type",
          "validator_message"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "target_invariant": {"type": "string", "minLength": 1},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "derived_seed": {"type": "integer", "minimum": 0},
          "status": {"enum": ["blocked", "escaped"]},
          "mutated_artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "validator_exception_type": {"type": ["string", "null"]},
          "validator_message": {"type": ["string", "null"]}
        }
      }
    },
    "repair_required": {"type": "boolean"},
    "self_certifying": {"const": false},
    "authority": {"const": false},
    "artifact_is_command": {"const": false},
    "network_access": {"const": false},
    "dynamic_code_loading": {"const": false},
    "human_promotion_required": {"const": true},
    "may_execute": {"const": false},
    "may_deploy": {"const": false},
    "may_merge": {"const": false},
    "may_sign": {"const": false},
    "may_broadcast": {"const": false},
    "may_access_wallet": {"const": false},
    "may_move_capital": {"const": false},
    "may_mutate_canonical_memory": {"const": false},
    "boundary_law": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "receipt_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
