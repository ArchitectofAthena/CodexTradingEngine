FROM python:3.14-slim@sha256:ce40764625a4ff50df3548277632e7f96c4e77fe75fa848aae9885476e7df5a4

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Refresh the pinned Debian runtime layer before application installation so
# fixable HIGH/CRITICAL OS vulnerabilities fail closed in the existing Trivy
# lane rather than surviving behind an otherwise content-addressed base image.
RUN apt-get update \
    && apt-get upgrade --yes --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md requirements.txt ./
COPY eve_q ./eve_q
COPY schemas ./schemas

RUN python -m pip install --upgrade \
        pip \
        "setuptools>=78.1.1" \
        "msgpack>=1.2.1" \
    && python -m pip install . \
    && groupadd --gid 10001 codex \
    && useradd --uid 10001 --gid codex --create-home --shell /usr/sbin/nologin codex \
    && mkdir -p /artifacts \
    && chown -R codex:codex /artifacts /home/codex

USER 10001:10001

ENTRYPOINT ["codex-gate1"]
CMD ["status"]
